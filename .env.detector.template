# GPU Detector Server Configuration (.env template)
# Copy this to HumanoidSupervisor2/Humanoid Livekit/ and customize

# ============================================================================
# GPU DETECTOR SERVER (runs in test_yolo environment)
# ============================================================================

# YOLO Model Configuration
YOLO_MODEL_NAME=yolo26n.pt
YOLO_PERSON_CLASS_ID=0
YOLO_CONF_THRESHOLD=0.25
YOLO_TRACKER_NAME=bytetrack.yaml

# Server Binding
GPU_DETECTOR_HOST=0.0.0.0
GPU_DETECTOR_PORT=8765

# GPU Configuration
# Options: cuda:0, cuda:1, cuda:2, ..., cpu
GPU_DETECTOR_DEVICE=cuda:0

# ============================================================================
# STREAM BRIDGE (runs in current environment)
# ============================================================================

# GPU Detector Client Configuration
# For local server:
GPU_DETECTOR_URL=http://127.0.0.1:8765/detect

# For remote server (on different machine):
# GPU_DETECTOR_URL=http://192.168.1.100:8765/detect

GPU_DETECTOR_TIMEOUT=2.0
GPU_DETECTOR_STREAM_ID=camera-bridge-detection

# Camera Configuration
CAMERA_ID=0
CLOSE_HEIGHT_RATIO=0.35
MAX_LOST_FRAMES=15

# ============================================================================
# DETECTION DISPATCH (optional - uncomment to enable)
# ============================================================================

# Enable conversation dispatch when person is detected
# DETECTION_DISPATCH_ENABLED=true
# DETECTION_DISPATCH_SUPERVISOR_URL=http://127.0.0.1:8080
# DETECTION_DISPATCH_ROOM=robot_room
# DETECTION_DISPATCH_AGENT_NAME=default
# DETECTION_DISPATCH_COOLDOWN_SECONDS=30

# ============================================================================
# LIVEKIT CONFIGURATION (used by stream_bridge)
# ============================================================================

# LIVEKIT_URL=ws://livekit-server:7880
# LIVEKIT_API_KEY=your_api_key
# LIVEKIT_API_SECRET=your_api_secret
