# A2 hackathon env template. Copy to `.env` and fill in the values marked replace-me.
# Every value not listed here falls back to a code default.

# --- Team identity -----------------------------------------------------------
# The Qdrant server on the robot is shared by all teams, so the collection
# prefix, active index slug and bootstrap collection are unique per team.
RAG_COLLECTION_PREFIX=team1_
RAG_ACTIVE_INDEX_SLUG=team1
RAG_QDRANT_COLLECTION=team1_knowledge

# --- LiveKit (local livekit-server on the robot) -----------------------------
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=ws://replace-me:7880
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me
LIVEKIT_ROOM=g1-lab
ROBOT_SUPERVISOR_DISPATCH_ROOM=g1-lab
LIVEKIT_AGENT_NAME=g1-listener
LIVEKIT_AGENT_WORKER=humanoid-voice-agent
LIVEKIT_AGENT_IDENTITY=agent-humanoid

# --- Supervisor --------------------------------------------------------------
ROBOT_SUPERVISOR_TOKEN=replace-me

# --- Azure OpenAI (LLM) ------------------------------------------------------
AZURE_OPENAI_BASE=https://replace-me.openai.azure.com/
AZURE_OPENAI_API_KEY=replace-me
OPENAI_API_VERSION=2025-01-01-preview
CHOSEN_COMPLETION_MODEL=gpt-5.4-nano
AZURE_LLM_DEPLOYMENT=gpt-5.4-nano

# --- Voice agent (voice canary stack) ----------------------------------------
VOICE_CANARY_ENABLED=true
VOICE_AGENT_PYTHON=.venv-voice-canary/bin/python
VOICE_LANGUAGE=sr
VOICE_LOCALE=sr-RS
TURN_DETECTION=vad

# --- Speech: Soniox STT + ElevenLabs TTS -------------------------------------
STT_PROVIDER=soniox
STT_MODEL=stt-rt-v4
SONIOX_API_KEY=replace-me
STT_LANGUAGE_HINTS=sr,en
SONIOX_LANGUAGE_HINTS=sr,en
TTS_PROVIDER=elevenlabs
TTS_MODEL=eleven_v3
TTS_LANGUAGE=sr
ELEVENLABS_API_KEY=replace-me
# Also used by navigation speech and the other TTS consumers.
TTS_VOICE_ID=replace-me

# --- Prompt variables --------------------------------------------------------
COMPANY_NAME=Comtrade System Integration
HUMANOID_ROBOT_NAME=TITAN

# --- A2 robot endpoints ------------------------------------------------------
AGIBOT_MOTION_COMMAND_URL=http://192.168.100.100:56444
AGIBOT_RESOURCE_SERVICE_URL=http://192.168.100.110:51049

# --- RAG (local rag_service + shared Qdrant) ---------------------------------
# rag_service only sees, creates and deletes collections that start with
# RAG_COLLECTION_PREFIX.
RAG_QDRANT_URL=http://127.0.0.1:6333
RAG_EXTERNAL_ENABLE=true
RAG_EXTERNAL_API_URL=http://127.0.0.1:8098
